{
  "name": "simas-manajemen-masjid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch-path=./server server/index.js\" \"vite\"",
    "dev:server": "node --watch-path=./server server/index.js",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  }
}